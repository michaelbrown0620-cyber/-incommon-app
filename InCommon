import React, { useState, useRef } from 'react';

type NavigationStep = 'TERMS_GATE' | 'EMAIL_VERIFY' | 'NEIGHBORHOOD_ZONE' | 'HOBBY_PROFILER' | 'SUCCESS_DASHBOARD';

interface GlobalSession {
  identityEmail: string;
  isTokenVerified: boolean;
  assignedRegion: string;
  profileName: string;
  profileBio: string;
  avatarColor: string;
  selectedHobbies: string[];
}

const STATIC_HOBBY_TREE = [
  { id: 'h1', category: 'Sports & Fitness', name: 'Pickleball' },
  { id: 'h2', category: 'Sports & Fitness', name: 'Running' },
  { id: 'h3', category: 'Sports & Fitness', name: 'Weightlifting' },
  { id: 'h4', category: 'Creative', name: 'Photography' },
  { id: 'h5', category: 'Creative', name: 'Nature photography' },
  { id: 'h6', category: 'Creative', name: 'Guitar' },
  { id: 'h7', category: 'Gaming', name: 'PC gaming' },
  { id: 'h8', category: 'Gaming', name: 'Tabletop RPGs' },
  { id: 'h9', category: 'Food & Cooking', name: 'Baking' },
  { id: 'h10', category: 'Food & Cooking', name: 'Coffee' },
];

const AVATAR_PALETTES = [
  { name: 'Ocean Blue', bg: 'bg-blue-600' },
  { name: 'Emerald Grass', bg: 'bg-emerald-600' },
  { name: 'Amber Glow', bg: 'bg-amber-600' },
  { name: 'Deep Purple', bg: 'bg-purple-600' }
];

export default function InCommonCoreApp() {
  const [currentStep, setCurrentStep] = useState<NavigationStep>('TERMS_GATE');
  const [session, setSession] = useState<GlobalSession>({
    identityEmail: '',
    isTokenVerified: false,
    assignedRegion: '',
    profileName: '',
    profileBio: '',
    avatarColor: 'bg-blue-600',
    selectedHobbies: []
  });

  return (
    <div className="min-h-screen bg-[#f8fafc] font-sans text-slate-800 flex flex-col justify-center p-4">
      <div className="max-w-md w-full mx-auto">
        
        {currentStep !== 'SUCCESS_DASHBOARD' && (
          <div className="flex justify-between items-center mb-6 px-3 text-[9px] font-black text-slate-400 uppercase tracking-widest select-none">
            <span className={currentStep === 'TERMS_GATE' ? 'text-blue-600' : ''}>1. Legal</span>
            <span>&rarr;</span>
            <span className={currentStep === 'EMAIL_VERIFY' ? 'text-blue-600' : ''}>2. Code</span>
            <span>&rarr;</span>
            <span className={currentStep === 'NEIGHBORHOOD_ZONE' ? 'text-blue-600' : ''}>3. Zone</span>
            <span>&rarr;</span>
            <span className={currentStep === 'HOBBY_PROFILER' ? 'text-blue-600' : ''}>4. Profile</span>
          </div>
        )}

        {currentStep === 'TERMS_GATE' && (
          <TermsEnforcementPanel 
            onCompletionConfirmed={(email) => {
              setSession(prev => ({ ...prev, identityEmail: email }));
              setCurrentStep('EMAIL_VERIFY');
            }}
          />
        )}

        {currentStep === 'EMAIL_VERIFY' && (
           {
              setSession(prev => ({ ...prev, isTokenVerified: true }));
              setCurrentStep('NEIGHBORHOOD_ZONE');
            }}
            onRollbackRequested={() => setCurrentStep('TERMS_GATE')}
          />
        )}

        {currentStep === 'NEIGHBORHOOD_ZONE' && (
          <GeneralizedLocationPanel 
            onRegionFinalized={(region) => {
              setSession(prev => ({ ...prev, assignedRegion: region }));
              setCurrentStep('HOBBY_PROFILER');
            }}
          />
        )}

        {currentStep === 'HOBBY_PROFILER' && (
          <HobbyProfilerPanel 
            session={session}
            setSession={setSession}
            onComplete={() => setCurrentStep('SUCCESS_DASHBOARD')}
          />
        )}

        {currentStep === 'SUCCESS_DASHBOARD' && (
          <div className="bg-white rounded-2xl border border-slate-200 shadow-xl p-6 space-y-5">
            <div className="flex items-center gap-4 border-b border-slate-100 pb-4">
              <div className={`w-12 h-12 rounded-full ${session.avatarColor} flex items-center justify-center text-white text-base font-black shadow-sm`}>
                {session.profileName ? session.profileName.substring(0,2).toUpperCase() : '??'}
              </div>
              <div>
                <h3 className="font-bold text-slate-900 text-lg">{session.profileName}</h3>
                <p className="text-xs text-slate-400">📍 Located inside {session.assignedRegion}</p>
              </div>
            </div>

            <div>
              <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Biography Card</span>
              <p className="text-xs text-slate-600 bg-slate-50 border border-slate-100 p-2.5 rounded-lg italic mt-1">"{session.profileBio}"</p>
            </div>

            <div>
              <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wide block mb-1.5">Active Hobby Vectors ({session.selectedHobbies.length})</span>
              <div className="flex flex-wrap gap-1.5">
                {session.selectedHobbies.map(h => (
                  <span key={h} className="bg-blue-50 text-blue-700 border border-blue-100 text-xs px-2.5 py-0.5 rounded-full font-medium">{h}</span>
                ))}
              </div>
            </div>

            <button 
              onClick={() => setCurrentStep('TERMS_GATE')}
              className="w-full text-center py-2 mt-4 border border-slate-200 hover:bg-slate-50 rounded-lg text-xs font-bold text-slate-600 transition-colors"
            >
              Reset Configuration Flow
            </button>
          </div>
        )}

      </div>
    </div>
  );
}

// ============================================================================
// SUBCOMPONENT: TERMS GATE ENFORCEMENT
// ============================================================================
function TermsEnforcementPanel({ onCompletionConfirmed }: { onCompletionConfirmed: (email: string) => void }) {
  const [fields, setFields] = useState({ email: '', secret: '' });
  const [agreed, setAgreed] = useState({ rules: false, platonic: false });
  const [unlocked, setUnlocked] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);

  const evaluateScrollPosition = () => {
    if (containerRef.current) {
      const { scrollTop, scrollHeight, clientHeight } = containerRef.current;
      if (scrollHeight - scrollTop <= clientHeight + 6) {
        setUnlocked(true);
      }
    }
  };

  return (
    <div className="bg-white rounded-2xl border border-slate-200 shadow-xl p-5 space-y-4">
      <div>
        <h3 className="text-base font-black text-slate-900">Create InCommon Account</h3>
        <p className="text-xs text-slate-400">Scroll the legal text below to unlock framework parameters.</p>
      </div>

      <div className="space-y-2.5">
        <div>
          <label className="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Email Vector</label>
          <input type="email" required value={fields.email} onChange={e=>setFields({...fields, email: e.target.value})} className="w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg outline-none focus:ring-1 focus:ring-blue-500 bg-slate-50" placeholder="name@domain.com" />
        </div>
        <div>
          <label className="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Password</label>
          <input type="password" required value={fields.secret} onChange={e=>setFields({...fields, secret: e.target.value})} className="w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg outline-none focus:ring-1 focus:ring-blue-500 bg-slate-50" />
        </div>
      </div>

      <div 
        ref={containerRef}
        onScroll={evaluateScrollPosition}
        className="h-24 overflow-y-auto bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-[10px] leading-relaxed text-slate-500 space-y-2 select-none"
      >
        <p className="font-bold text-slate-800">1. Strict Platonic System Safeguard</p>
        <p>InCommon is configured strictly for interest matching and neighborhood community networking. Dating, romantic advances, network marketing, and recruitment hunting are explicitly banned.</p>
        <p className="font-bold text-slate-800">2. Geolocation Restrictions</p>
        <p>The system does not monitor or cache live physical coordinate parameters. Data structures evaluate purely on macro-regional neighborhood fields to verify baseline security.</p>
      </div>

      <div className={`space-y-2 transition-opacity duration-300 ${unlocked ? 'opacity-100' : 'opacity-30 pointer-events-none'}`}>
        <label className="flex items-start gap-2 text-xs cursor-pointer">
          <input type="checkbox" checked={agreed.rules} disabled={!unlocked} onChange={e=>setAgreed({...agreed, rules: e.target.checked})} className="mt-0.5" />
          <span className="text-slate-600">I accept the user terms, conditions, and privacy policies.</span>
        </label>
        <label className="flex items-start gap-2 text-xs cursor-pointer">
          <input type="checkbox" checked={agreed.platonic} disabled={!unlocked} onChange={e=>setAgreed({...agreed, platonic: e.target.checked})} className="mt-0.5" />
          <span className="text-blue-700 font-semibold">⚠️ I verify I will not utilize this application for romantic prospecting or recruitment.</span>
        </label>
      </div>

      <button
        onClick={() => fields.email && agreed.rules && agreed.platonic && onCompletionConfirmed(fields.email)}
        disabled={!agreed.rules || !agreed.platonic}
        className="w-full bg-slate-900 text-white font-bold text-xs py-2 rounded-lg transition-all disabled:bg-slate-200 disabled:text-slate-400 shadow-sm"
      >
        Verify System Safeguards & Request Code
      </button>
    </div>
  );
}

